# HidraVPN node — systemd unit.
#
# The node keeps its own key (/etc/hidravpn) and the leases of the clients
# it admitted (/var/lib/hidravpn, which survive a reboot). It runs as root
# because it creates a network interface, sets routes and firewall rules;
# everything else is taken away below.
[Unit]
Description=HidraVPN node
After=network-online.target
Wants=network-online.target
# Five failed starts in a minute means something is wrong (no settings file,
# no binary); stop and wait for a person instead of filling the journal.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/hidravpn-node --config /etc/hidravpn/node.toml run
# Always: a node that stopped for any reason comes back; the burst limit
# above still stops a crash loop. Enough descriptors that no client can run
# the node out of them.
Restart=always
RestartSec=3
LimitNOFILE=65536
# /var/lib/hidravpn holds the leases (the admitted clients), which survive a
# restart and a reboot alike; /run/hidravpn and /run/wireguard hold what is
# only for this boot (the userspace WireGuard control socket). systemd
# creates them, so they exist whichever path the node takes, and makes them
# writable under the read-only system below.
StateDirectory=hidravpn
StateDirectoryMode=0700
RuntimeDirectory=hidravpn wireguard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Logs go to the journal: counts and states, never addresses or names.
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=hidravpn_node=info

# Hardening. CAP_NET_ADMIN for the interface, routes and nftables;
# CAP_NET_BIND_SERVICE for DNS on port 53; CAP_NET_RAW for the UDP socket
# options WireGuard uses.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/proc/sys/net
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
DeviceAllow=/dev/net/tun rw
DevicePolicy=closed
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
